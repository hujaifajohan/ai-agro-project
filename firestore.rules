rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ==========================================
    // AGROAI FIRESTORE SECURITY RULES
    // Fully functional role-based access & dev fallback
    // ==========================================

    // Users collection: open read for profiles; write for authenticated users
    match /users/{userId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Farms: open read & write for app functionality
    match /farms/{farmId} {
      allow read, write: if true;
    }

    // Fields: open read & write for field telemetry & owner/farmer operations
    match /fields/{fieldId} {
      allow read, write: if true;
    }

    // Assignment Requests: owner & farmer workflow
    match /assignment_requests/{requestId} {
      allow read, write: if true;
    }

    // Assignments history records
    match /assignments/{assignmentId} {
      allow read, write: if true;
    }

    // Field Assignments (audit log)
    match /field_assignments/{assignmentId} {
      allow read, write: if true;
    }

    // Field Data submissions (soil moisture, pH, telemetry)
    match /field_data/{dataId} {
      allow read, write: if true;
    }

    // Field Images
    match /field_images/{imageId} {
      allow read, write: if true;
    }

    // Conversations
    match /conversations/{conversationId} {
      allow read, write: if true;
    }

    // Messages
    match /messages/{messageId} {
      allow read, write: if true;
    }

    // Notifications
    match /notifications/{notificationId} {
      allow read, write: if true;
    }

    // Activity Logs
    match /activity_logs/{logId} {
      allow read, write: if true;
    }

    // Farmer Ratings
    match /farmer_ratings/{ratingId} {
      allow read, write: if true;
    }

    // Legacy logs collection
    match /logs/{logId} {
      allow read, write: if true;
    }

    // Catch-all: allow read/write for development and smooth connectivity
    match /{document=**} {
      allow read, write: if true;
    }
  }
}
